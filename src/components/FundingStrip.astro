---
import { hasPublic } from '../lib/assets';
const items = [
  { href: '/funding/ndis/', title: 'NDIS participants', logo: '/images/brand/ndis.png', alt: 'NDIS' },
  { href: '/funding/dva/', title: 'Veterans (DVA)', logo: '/images/brand/dva.png', alt: 'DVA' },
  { href: '/funding/aged-care-support-at-home/', title: 'Aged care / Support at Home', logo: '/images/brand/support-at-home.png', alt: 'Support at Home' },
];
---
<section class="wrap" style="padding-bottom: var(--section)">
  <div class="panel panel--tint fund">
    <div style="flex: 1 1 340px">
      <h2 style="font-size: clamp(28px, 3.4vw, 36px); margin-bottom: 10px">Funded? We make it simple.</h2>
      <p class="muted">We work directly with your plan manager, case manager or provider.</p>
    </div>
    <div class="grid fit" style="--min: 180px; flex: 2 1 520px">
      {items.map((i) => (
        <a class="fcard" href={i.href}>
          {hasPublic(i.logo) ? <img src={i.logo} alt={i.alt} style="height:40px;width:auto" /> : <span class="flogo">[{i.alt.toUpperCase()} LOGO]</span>}
          <strong>{i.title}</strong>
        </a>
      ))}
    </div>
  </div>
</section>
<style>
  .fund { display: flex; flex-wrap: wrap; gap: 32px; align-items: center; }
  .fcard { background: var(--white); border-radius: 16px; padding: 20px; text-decoration: none; color: var(--ink); display: flex; flex-direction: column; gap: 8px; }
  .fcard:hover strong { color: var(--red-700); }
  .flogo { height: 40px; border: 1px dashed var(--red-200); border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 12px; color: var(--red-800); }
</style>
