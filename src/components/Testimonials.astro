---
import { testimonials } from '../data/site';
---
<section class="section section--white">
  <div class="wrap grid fit" style="--min: 340px; gap: 24px">
    {testimonials.map((t) => (
      <figure class="quote">
        <blockquote>"{t.quote}"</blockquote>
        <figcaption>{t.name}, {t.place}</figcaption>
      </figure>
    ))}
  </div>
</section>
<style>
  .quote { margin: 0; background: var(--grey-50); border-radius: 24px; padding: clamp(26px, 4vw, 36px); }
  blockquote { margin: 0; font-family: var(--font-display); font-size: clamp(21px, 2.4vw, 26px); line-height: 1.3; font-weight: 500; }
  figcaption { margin-top: 18px; font-weight: 700; color: var(--grey-700); }
</style>
