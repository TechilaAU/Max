---
import Page from '../../layouts/Page.astro';
import WhyMax from '../../components/WhyMax.astro';
import Testimonials from '../../components/Testimonials.astro';
---
<Page title="About Max" h1="About Max Healthcare Equipment" description="Proudly South Australian owned and operated. Healthcare and mobility equipment for hire and purchase with next-day delivery and an on-site Occupational Therapist." eyebrow="About" crumbs={[{ label: 'About' }]}
  lede="At Max Healthcare Equipment we aim to put the smile back into the healthcare equipment industry. It's more than just equipment to us." photoSlot="team" photoLabel="The Max team in the showroom">
  <div class="split" style="align-items: flex-start">
    <div class="prose">
      <h2 style="margin-top:0">Who we are</h2>
      <p>We're a proudly South Australian owned and operated business supplying healthcare and mobility equipment for hire and purchase. Our range exceeds 600 items, from walking aids to electric high-low beds, lift recliners and mobility scooters.</p>
      <p>Our clinical governance is overseen by our on-site Occupational Therapist, and our delivery and installation staff are kept up to date with equipment training and product knowledge.</p>
      <p>We work closely with suppliers locally and nationally, so if you need a specialised piece of equipment, we'll help you find it.</p>
    </div>
    <div class="grid" style="--min: 220px">
      <a class="card link-card" href="/about/our-team/"><strong style="font-size: 20px">Our team</strong><span class="muted">OT, customer service and delivery</span></a>
      <a class="card link-card" href="/about/testimonials/"><strong style="font-size: 20px">Testimonials</strong><span class="muted">What our clients say</span></a>
      <a class="card link-card" href="/about/careers/"><strong style="font-size: 20px">Careers</strong><span class="muted">Work with us</span></a>
      <a class="card link-card" href="/locations/adelaide/"><strong style="font-size: 20px">Where we deliver</strong><span class="muted">Adelaide and surrounds</span></a>
    </div>
  </div>
  <div slot="after"><WhyMax /><Testimonials /></div>
</Page>
