---
import Page from '../layouts/Page.astro';
---
<Page title="Cleaning and infection control" description="All Max Healthcare Equipment is thoroughly cleaned between clients to Safe Work Australia standards. Contactless delivery available." eyebrow="Safety" crumbs={[{ label: 'Cleaning and infection control' }]}
  lede="All of our equipment is thoroughly cleaned to make sure it's safe to use and safe from transmissible diseases.">
  <div class="prose">
    <h2 style="margin-top:0">Our cleaning standard</h2>
    <p>We follow Safe Work Australia cleaning standards for every item returned from hire. See the <a href="https://www.safeworkaustralia.gov.au/sites/default/files/2020-04/COVID-19-Cleaning-Checklist.pdf" rel="noopener">Safe Work Australia cleaning checklist</a>.</p>
    <h2>Help us keep everyone safe</h2>
    <p>Please tell our team if you have recently been in contact with someone who has COVID-19, or if anyone in the home has cold or flu-like symptoms. Contactless delivery and collection is available where possible.</p>
  </div>
</Page>
